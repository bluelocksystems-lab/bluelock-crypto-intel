# ─────────────────────────────────────────────────────────────
#  BlueLock Crypto Intel Dashboard - Environment Configuration
# ─────────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in your API key.
#
#  ETHERSCAN API V2 NOTE:
#  Etherscan V2 uses one unified API key for supported EVM chains.
#  Put your Etherscan V2 key in ETHERSCAN_API_KEY first.
#
#  GET FREE KEY:
#   Etherscan → https://etherscan.io/apis
# ─────────────────────────────────────────────────────────────

# Unified Etherscan API V2 key
# Works for Ethereum plus supported EVM chains through chainid routing.
ETHERSCAN_API_KEY=

# Optional compatibility fields.
# Leave blank unless you intentionally want separate keys.
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=

# ── Optional settings ────────────────────────────────────────
# Max transactions to fetch per query (default: 50)
MAX_TX_FETCH=50

# SQLite database file path (default: data/cases.db)
DB_PATH=data/cases.db
